			<trans-unit id="action.fetchToken">
				<source>Fetch token (app-only)</source>
			</trans-unit>

			<trans-unit id="action.fetchToken.description">
				<source>Acquires a fresh OAuth 2.0 client_credentials access token for this client without any user redirect. Use to verify credentials and admin-consent for service-to-service flows.</source>
			</trans-unit>

			<trans-unit id="token.status.cached">
				<source>Token valid until</source>
			</trans-unit>

			<trans-unit id="token.status.cached.title">
